<%- include('partials/header', { title: 'Verify email', bodyClass: 'auth-page' }) %>

<div class="container">
  <div class="row justify-content-center">
    <div class="col-12 col-sm-10 col-md-7 col-lg-5">
      <div class="card auth-card shadow-lg border-0">
        <div class="card-body p-4 p-md-5">
          <h1 class="h3 mb-1">Verify email</h1>
          <p class="text-muted mb-4">
            <strong><%= email %></strong> manziliga 6 xonali kod yuborildi.
            Email sozlanmagan bo'lsa, kod <strong>serverni ishga tushirgan terminalda</strong> chiqadi.
          </p>

          <% if (errors.length) { %>
            <div class="alert alert-danger">
              <ul class="mb-0 ps-3"><% errors.forEach((e) => { %><li><%= e %></li><% }) %></ul>
            </div>
          <% } %>

          <form method="post" action="/verify">
            <input type="hidden" name="email" value="<%= email %>">
            <div class="mb-4">
              <label for="code" class="form-label">Tasdiqlash kodi</label>
              <input type="text" class="form-control form-control-lg text-center code-input" id="code" name="code"
                     required inputmode="numeric" pattern="\d{6}" maxlength="6" autocomplete="one-time-code"
                     placeholder="000000" autofocus>
            </div>
            <button type="submit" class="btn btn-primary w-100">Verify</button>
          </form>

          <form method="post" action="/verify/resend" class="text-center mt-3">
            <input type="hidden" name="email" value="<%= email %>">
            <button type="submit" class="btn btn-link">Kodni qayta yuborish</button>
          </form>
          <p class="text-center text-muted small mb-0">Kod 10 daqiqa amal qiladi</p>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
